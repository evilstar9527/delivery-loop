{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delivery-loop-control-plane",
  "account_id": "b8488957e88658039d2a38fb8f160514",
  "send_metrics": false,
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_AUTH_MODE": "pat",
    "GITHUB_ALLOWED_REPOSITORIES": "[\"lightspeed-intelligence/tipsy-backend\"]",
    "GITHUB_OIDC_AUDIENCE": "delivery-loop-control-plane",
    "CONTROL_PLANE_URL": "https://delivery-loop-control-plane.eve55265.workers.dev",
    "CODEX_MODEL_PROFILE_ID": "codex-gpt-5p6-terra-medium-tool-loop-20260811",
    "TEST_DEPLOY_TARGETS_JSON": "[{\"repository\":\"lightspeed-intelligence/tipsy-backend\",\"provider\":\"yunxiao_pipeline\",\"environment\":\"test\",\"workflowPath\":\".github/workflows/delivery-test-deploy.yml\",\"oidcAudience\":\"delivery-loop-test-deploy\",\"roleRef\":\"test:yunxiao-pipeline\",\"organizationId\":\"68c3d49cbb64aae551955854\",\"pipelineId\":\"5186274\",\"repositoryUrl\":\"https://github.com/Lightspeed-Intelligence/tipsy-backend.git\"}]"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "delivery-loop-control",
      "database_id": "8cd2d08d-1db1-4cd8-8598-caaca308c7fd",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "TOOL_BRIDGE",
      "service": "delivery-loop-tool-bridge"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TASK_OBJECTS",
      "bucket_name": "delivery-loop-task-objects"
    },
    {
      "binding": "CHECKPOINT_OBJECTS",
      "bucket_name": "delivery-loop-checkpoint-objects"
    },
    {
      "binding": "BACKUP_OBJECTS",
      "bucket_name": "delivery-loop-backups"
    },
    {
      "binding": "RAW_AGENT_OBJECTS",
      "bucket_name": "delivery-loop-raw-agent-objects"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORKFLOW_OUTBOX_QUEUE",
        "queue": "delivery-loop-workflow-outbox"
      },
      {
        "binding": "FEISHU_INGRESS_QUEUE",
        "queue": "delivery-loop-feishu-ingress"
      }
    ],
    "consumers": [
      {
        "queue": "delivery-loop-workflow-outbox",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "delivery-loop-workflow-outbox-dlq"
      },
      {
        "queue": "delivery-loop-workflow-outbox-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 60,
        "dead_letter_queue": "delivery-loop-workflow-outbox-dlq-quarantine"
      },
      {
        "queue": "delivery-loop-feishu-ingress",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "delivery-loop-feishu-ingress-dlq"
      },
      {
        "queue": "delivery-loop-feishu-ingress-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 60,
        "dead_letter_queue": "delivery-loop-feishu-ingress-dlq-quarantine"
      }
    ]
  },
  "workflows": [
    {
      "name": "delivery-run",
      "binding": "DELIVERY_RUN",
      "class_name": "DeliveryRunWorkflow"
    },
    {
      "name": "control-plane-backup",
      "binding": "CONTROL_PLANE_BACKUP",
      "class_name": "ControlPlaneBackupWorkflow",
      "limits": {
        "steps": 300
      }
    }
  ]
}
