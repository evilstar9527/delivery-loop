{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delivery-loop-agent-executor",
  "account_id": "041d4868e5611b45f9959f4f58c1e4c7",
  "send_metrics": false,
  "main": "src/executor/cloudflare-worker/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "EXECUTOR_IMAGE_REF": "registry.cloudflare.com/041d4868e5611b45f9959f4f58c1e4c7/delivery-agent-sandbox@sha256:6eb5753350278abfda7c9a6ff8efa7eca2be30ce118fe622de295caffd79c268",
    "EXECUTOR_IMAGE_DIGEST": "sha256:6eb5753350278abfda7c9a6ff8efa7eca2be30ce118fe622de295caffd79c268",
    "TOOL_BRIDGE_BASE_URL": "https://tool-bridge.fantacy.live",
    "TOOL_BRIDGE_SLS_LOGSTORE": "tipsy-chat",
    "TOOL_BRIDGE_SLS_ENVIRONMENT": "prod"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EXECUTOR_SANDBOX",
        "class_name": "DeliveryAgentSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeliveryAgentSandbox"]
    }
  ],
  "containers": [
    {
      "name": "delivery-agent-sandbox",
      "class_name": "DeliveryAgentSandbox",
      "image": "registry.cloudflare.com/041d4868e5611b45f9959f4f58c1e4c7/delivery-agent-sandbox@sha256:6eb5753350278abfda7c9a6ff8efa7eca2be30ce118fe622de295caffd79c268",
      "max_instances": 10,
      "instance_type": "standard-1"
    }
  ]
}
