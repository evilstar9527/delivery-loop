{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delivery-loop-tool-bridge",
  "account_id": "b8488957e88658039d2a38fb8f160514",
  "send_metrics": false,
  "main": "src/tools/cloudflare-telemetry-worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "b8488957e88658039d2a38fb8f160514",
